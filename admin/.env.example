VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Google Sign-In (optional). Same value as GOOGLE_CLIENT_ID in backend/.env.
# Only accounts that are ALREADY role="admin" can sign in this way — it
# never creates a new account. Leave empty to hide the button.
VITE_GOOGLE_CLIENT_ID=
