# Copy this file to .env and fill in your own values.

# MongoDB connection string.
# Local MongoDB:   mongodb://127.0.0.1:27017/soalect
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/soalect
MONGO_URI=mongodb://127.0.0.1:27017/soalect

# Server port
PORT=5000

# JWT secret — change this to a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret

# Comma-separated list of origins allowed to call this API
# (the storefront and the admin dashboard dev servers)
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174

# Your real production domain — used to build absolute URLs in the
# dynamic sitemap (backend/routes/sitemapRoutes.js). Not needed locally.
SITE_URL=https://www.soalect.com

# Used by utils/seedAdmin.js to create/promote the first admin account
ADMIN_NAME=SOALECT Admin
ADMIN_EMAIL=admin@soalect.com
ADMIN_PASSWORD=ChangeMe123!

# Google Sign-In (optional). Get this from Google Cloud Console →
# APIs & Services → Credentials → OAuth 2.0 Client ID (Web application).
# Must be the SAME value as VITE_GOOGLE_CLIENT_ID in frontend/.env.
# Leave empty to disable Google Sign-In — the rest of the site still works.
GOOGLE_CLIENT_ID=
